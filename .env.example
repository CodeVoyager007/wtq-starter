# Copy this file to backend/.env and paste your key. Never commit or submit the real .env.
# Allowed models only (participant guide 9.1): gemini-3.5-flash-lite or gemini-3.1-flash-lite.
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.5-flash-lite
API_KEY=your-api-key-here
# Optional second key from a different Google account; used when the first is rate limited.
API_KEY_BACKUP=
# Free tier allows 15 requests/min; stay a little under it.
REQUESTS_PER_MINUTE=12
# Where model responses are cached (makes reruns identical and free).
CACHE_DIR=.cache
